{
    "logging": {
        "level": "INFO"
    },
    "seed": {
        "torch": 42,
        "np": 42,
        "random": 42
    },
    "model": {
        "type": "local",
        "openai": {
            "model": "gpt-4o-mini",
            "api_key_env": "OPENAI_API_KEY",
            "temperature": 0.0,
            "max_tokens": 256
        },
        "local": {
            "model_name": "unsloth/mistral-7b-instruct-v0.3",
            "max_seq_length": 2048,
            "lora_rank": 32,
            "load_in_4bit": false,
            "temperature": 0.0,
            "max_new_tokens": 256,
            "gpu_memory_utilization": 0.8,
            "stop_strings": ["</answer>"]
        }
    },
    "data": {
        "base_dir": "data",
        "casino": {
            "test": "casino/ca.test.csv",
            "train": "casino/ca.train.csv"
        },
        "dnd": {
            "test": "dnd/dnd.test.csv",
            "train": "dnd/dnd.train.csv"
        }
    },
    "eval": {
        "n_instances": 50,
        "tasks": {
            "dnd": [
                "sta_total_item_count_dnd",
                "sta_max_points_dnd",
                "sta_ask_point_values_dnd"
            ],
            "ca": [
                "sta_total_item_count_ca",
                "sta_max_points_ca",
                "sta_ask_point_values_ca",
                "sta_ask_high_priority_ca",
                "sta_ask_low_priority_ca"
            ]
        }
    }
}
